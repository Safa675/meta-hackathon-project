{
  "manifest_version": 3,
  "name": "Focus (Meta Hackathon Project)",
  "version": "0.0.1",
  "description": "A focus agent that knows what you meant to do and notices when you drift.",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "idle",
    "notifications"
  ],
  "host_permissions": [
    "https://claude.ai/code/*",
    "https://api.meta.ai/*",
    "https://api.together.xyz/*",
    "https://api.fireworks.ai/*",
    "https://inference.baseten.co/*",
    "https://api.groq.com/*",
    "https://api.tokenfactory.us-north1.nebius.com/*",
    "https://openrouter.ai/*",
    "http://localhost:11434/*"
  ],
  "background": {
    "service_worker": "extension/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/code/*"
      ],
      "js": [
        "extension/content/claude-code.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "extension/popup/popup.html",
    "default_icon": {
      "16": "extension/icons/icon-16.png",
      "32": "extension/icons/icon-32.png",
      "48": "extension/icons/icon-48.png"
    }
  },
  "options_page": "extension/options/options.html",
  "icons": {
    "16": "extension/icons/icon-16.png",
    "32": "extension/icons/icon-32.png",
    "48": "extension/icons/icon-48.png",
    "128": "extension/icons/icon-128.png"
  }
}
