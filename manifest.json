{
  "manifest_version": 3,
  "name": "Meta Hackathon Project",
  "version": "0.0.1",
  "description": "A focus agent that knows what you meant to do and notices when you drift.",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["https://claude.ai/code/*"],
  "background": { "service_worker": "extension/background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/code/*"],
      "js": ["extension/content/claude-code.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "extension/popup/popup.html" },
  "options_page": "extension/options/options.html"
}
