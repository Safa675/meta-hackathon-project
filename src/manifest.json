{
  "manifest_version": 3,
  "name": "Tuck — focus companion",
  "version": "0.0.1",
  "description": "A little folded companion that knows what you meant to do and notices when you drift.",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "idle",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://api.meta.ai/*",
    "https://api.together.xyz/*",
    "https://api.fireworks.ai/*",
    "https://inference.baseten.co/*",
    "https://api.groq.com/*",
    "https://api.tokenfactory.us-north1.nebius.com/*",
    "https://openrouter.ai/*",
    "http://localhost:11434/*"
  ],
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "shared/icons/icon-16.png",
      "32": "shared/icons/icon-32.png",
      "48": "shared/icons/icon-48.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "shared/icons/icon-16.png",
    "32": "shared/icons/icon-32.png",
    "48": "shared/icons/icon-48.png",
    "128": "shared/icons/icon-128.png"
  }
}
